# Copy to .env and fill in locally. Never commit .env.

GROQ_API_KEY=gsk_your_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# API gateway. Generate the key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# Password for the "admin" account. Unset: no admin account is created.
# Changing it resets an existing admin account's password on the next start.
ADMIN_PASSWORD=
