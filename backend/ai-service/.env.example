# AI Service Configuration

# Service Info
SERVICE_NAME=ai-service
ENVIRONMENT=development

# LLM Provider — groq (default), openai, or gemini
LLM_PROVIDER=groq

# Groq Configuration (https://console.groq.com)
LLM_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
# LLM_GROQ_URL=https://api.groq.com/openai/v1

# OpenAI Configuration (alternative)
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# Google Gemini Configuration (alternative)
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-pro

# LLM Parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_MAX_TOOL_ITERATIONS=6

# Internal service URLs (Docker network uses port 8000)
DEPLOYMENT_SERVICE_URL=http://deployment-service:8000
MONITORING_SERVICE_URL=http://monitoring-service:8000
TRAINING_SERVICE_URL=http://training-service:8000
MLFLOW_URL=http://mlflow:5000
PROMETHEUS_URL=http://prometheus:9090

# Vector DB (for Phase 2.2 - RAG)
VECTOR_DB_URL=http://vector-db:6333
VECTOR_DB_COLLECTION=mlops_knowledge
