# AI Service Configuration

# Service Info
SERVICE_NAME=ai-service
ENVIRONMENT=development

# LLM Provider (openai, ollama, or gemini)
LLM_PROVIDER=openai

# OpenAI Configuration
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4

# Ollama Configuration (if using local LLM)
# LLM_PROVIDER=ollama
# LLM_MODEL=neural-chat  # or mistral, llama2, etc

# Google Gemini Configuration (if using Gemini)
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-pro

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Service URLs (internal communication)
DEPLOYMENT_SERVICE_URL=http://deployment-service:8003
MONITORING_SERVICE_URL=http://monitoring-service:8004
TRAINING_SERVICE_URL=http://training-service:8002

# Vector DB (for Phase 2.2 - RAG)
VECTOR_DB_URL=http://vector-db:6333
VECTOR_DB_COLLECTION=mlops_knowledge
