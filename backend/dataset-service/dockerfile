FROM python:3.11-slim

WORKDIR /app

COPY ./backend/dataset-service /app
COPY ./shared /shared

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    sqlalchemy \
    psycopg2-binary \
    python-multipart \
    pandas

ENV PYTHONPATH=/app:/shared

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]